PROG.DEPS:
  LOOP
    PRINT ""
    PRINT 'PROGRAM DEPS OF ':PROG.NAME
    READ R FROM F.STACK.DEPS, PROG.NAME ELSE R=''
    PROG.LIST=''
    * PROG.LIST<1>=LEFT (CALLED BY), PROG.LIST<2>=MIDDLE (CURRENT), PROG.LIST<3>=RIGHT (CALLS)
    R1=DCOUNT(R<1>,@VM)
    FOR F=1 TO R1
      PROG.LIST<1,-1>=R<1,F>
    NEXT F
    PROG.LIST<2>=PROG.NAME
    R2=DCOUNT(R<2>,@VM)
    FOR F=1 TO R2
      PROG.LIST<3,-1>=R<2,F>
    NEXT F
    IF R2 > R1 THEN MAX=R2 ELSE MAX=R1
    PRINT SPACE(5):'CALLED/EXECUTED FROM' 'L#35':' ':'PROGRAM' 'L#40':' ':'CALLS/EXECUTES' 'L#35'
    FOR F=1 TO MAX
      PRINT F'R#3':') ':PROG.LIST<1,F>'L#35':' ':PROG.LIST<2,F>'L#35':' ':F'R#3':') ':PROG.LIST<3,F>'L#35'
    NEXT F
    PRINT ''
    PRINT 'Enter F for files, Ln for left side # or Rn for right side, ENTER to exit:':
    INPUT O
    IF O[1,1]='L' THEN PROG.NAME=PROG.LIST<1,O[2,9]>
    IF O[1,1]='R' THEN PROG.NAME=PROG.LIST<3,O[2,9]>
    IF O='F' THEN
      PRINT ''
      FOR FILE=1 TO DCOUNT(R<3>,@VM)
        PRINT 'File:':R<3,FILE>
      NEXT F
    END
    IF O='' THEN EXIT
  REPEAT
RETURN
*
DEPS.BUILD:
  * DEP.REC<1>=CALLED BY
  * DEP.REC<2>=CALLS
  * DEP.REC<3>=OPENS
  * DEP.REC<4>=READS
  * DEP.REC<5>=WRITES
  * DEP.REC<6>=CLEARS
  * DEP.REC<7>=INCLUDES
  * DEP.REC<8>=JOBS
  *
  OPEN 'STACK.DEPS' TO F.STACK.DEPS ELSE
    EXECUTE \CREATE.FILE STACK.DEPS 1113,1\
    OPEN 'STACK.DEPS' TO F.STACK.DEPS ELSE PRINT 'Cannot open or create STACK.DEPS' ; BUILD.OK=0 ; RETURN
  END
  CLEARFILE F.STACK.DEPS
  *
  KEYWORDS=CONVERT(",",@AM,"CALL,CHAIN,CLEARFILE,EXECUTE,INCLUDE,$INCLUDE,OPEN,READ,WRITE")
  *
  EXECUTE \SSELECT \:BP.FILE:\ WITH @ID # "_]"\
  LOOP
    READNEXT ID ELSE EXIT
    PRINT ID
    READ PROGRAM FROM F.BP, ID ELSE CONTINUE
    FILE.HANDLES=''
    DEFERRED=''
    READ DEP.REC FROM F.STACK.DEPS, ID ELSE DEP.REC=''
    MAX.LINE=DCOUNT(PROGRAM,@AM)
    FOR LINE.CTR=1 TO MAX.LINE
      GOSUB PROCESS.LINE
    NEXT LINE.CTR
    WRITE DEP.REC ON F.STACK.DEPS, ID
  REPEAT
  * Re-process any deferred lines
RETURN
*
PROCESS.LINE:
  LINE=TRIM(PROGRAM<LINE.CTR>) ;* removes leading, trailing and contiguous spaces
  FIRST=FIELD(LINE,' ',1)
  IF FIRST='IF' OR FIRST='ELSE' OR FIRST='CASE' THEN
    * E.g. IF A=B THEN EXECUTE "SPECIAL.PROG"
    * and we're going to ditch everything
    LOOP
      FIRST=FIELD(LINE,' ',1)
      LOCATE FIRST IN KEYWORDS SETTING POS THEN EXIT ELSE DEL LINE<1>
    UNTIL LINE='' DO
    REPEAT
  END
  SECOND=FIELD(LINE,' ',2)
  BEGIN CASE
    CASE SECOND[1,9]='FILE.OPEN'              ;* CALL FILE.OPEN(PROG,'FILE.NAME,SUB.FILE',F.FILE.NAME,'STOP')
      LINE=CONVERT(' ','',LINE)
      FRM=INDEX(LINE,',',1)+1
      CH=LINE[FRM,1]
      IF CH=\"\ OR CH=\'\ OR CH='\' THEN
        * Look forward until we find the closing quote
        X=FRM+1 ; LL=LEN(LINE)
        LOOP
          NEXT.CH=LINE[X,1]
        UNTIL NEXT.CH=CH OR X>LL DO
          X+=1
        REPEAT
        S=LINE[FRM,X-FRM+1]
        GOSUB REMOVE.QUOTES
      END ELSE
        * Filename is a variable so don't have to worry about embedded commas
        S=FIELD(LINE,',',2)
        GOSUB REMOVE.QUOTES
      END
      FVAR=FIELD(LINE,',',3)
      GOSUB CHECK.OPEN
    CASE FIRST='CALL'                         ;* CALL SUBR(1,2,3) or CALL SUBR ( 1, 2, 3)
      LINE=CONVERT(' ','',LINE[6,999])
      SUBR=FIELD(LINE,'(',1)
      *READV T FROM VOC, SUBR, 1 ELSE RETURN ;* Make sure the thing we're calling is a cataloged program
      *IF T # 'C' THEN RETURN ;* Only care about cataloged programs
      LOCATE SUBR IN DEP.REC<2> BY 'AL' SETTING POS ELSE INS SUBR BEFORE DEP.REC<2,POS>
      READV CALLED.BY FROM F.STACK.DEPS, SUBR, 1 ELSE CALLED.BY=''
      LOCATE ID IN CALLED.BY<1> BY 'AL' SETTING POS ELSE
        INS ID BEFORE CALLED.BY<1,POS>
        WRITEV CALLED.BY ON F.STACK.DEPS, SUBR, 1
      END
    CASE FIRST='CLEARFILE'                    ;* CLEARFILE FVAR
      LOCATE SECOND IN FILE.HANDLES<1> SETTING POS THEN
        * Figure out which file is being cleared and store in DEP.REC
        DEP.REC<8,-1>=DEP.REC<5,POS>
      END
    CASE FIRST='EXECUTE' OR FIRST='CHAIN'     ;* EXECUTE "NJS.EXIT2" or EXECUTE STMT
      S=SECOND
      GOSUB REMOVE.QUOTES
      EXEC=S
      IF EXEC='' THEN RETURN
      IF LEN(EXEC) > 100 THEN RETURN ;* Not a valid ID to check, skip
      *READV T FROM VOC, EXEC, 1 ELSE RETURN ;* Make sure the thing we're executing is a VOC entry
      *IF T # 'C' THEN RETURN ;* Only care about cataloged programs
      LOCATE EXEC IN DEP.REC<2> BY 'AL' SETTING POS ELSE INS EXEC BEFORE DEP.REC<2,POS>
      READV CALLED.BY FROM F.STACK.DEPS, EXEC, 1 ELSE CALLED.BY=''
      LOCATE ID IN CALLED.BY<1> BY 'AL' SETTING POS ELSE
        INS ID BEFORE CALLED.BY<1,POS>
        WRITEV CALLED.BY ON F.STACK.DEPS, EXEC, 1
      END
    CASE FIRST='INCLUDE' OR FIRST='$INCLUDE'  ;* INCLUDE CUSTOM,BPI ASSIGN.VARS or $INCLUDE RECORD.LOCKS.DIM FROM IL.BPI
      LINE.REC=CONVERT(' ',@AM,LINE)
      IF INDEX(LINE,'FROM',1) THEN
        INC.FILE=LINE.REC<4>
        INC.ITEM=LINE.REC<2>
      END ELSE
        INC.FILE=LINE.REC<2>
        INC.ITEM=LINE.REC<3>
      END
      INC=INC.FILE:' ':INC.ITEM
      LOCATE INC IN DEP.REC<7> BY 'AL' SETTING POS ELSE
        INS INC BEFORE DEP.REC<7,POS>
      END
    CASE FIRST[1,4]='OPEN'                         ;* OPEN "LS.MASTER,LS.BILLING" TO FVAR ELSE..  OPEN "","LS.MASTER" TO ..
      IF FIRST[5,1]=\"\ OR FIRST[5,1]=\'\ THEN
        LINE='OPEN ':LINE[5,LEN(LINE)]
        FIRST=FIELD(LINE,' ',1)
        SECOND=FIELD(LINE,' ',2)
      END
      IF FIRST # 'OPEN' THEN RETURN
      SWAP \"",\ WITH \\ IN SECOND
      SWAP \'',\ WITH \\ IN SECOND
      S=SECOND
      GOSUB REMOVE.QUOTES
      FRM=INDEX(LINE,'TO',1)
      X=FRM+3
      LL=LEN(LINE)
      LOOP
        NEXT.CH=LINE[X,1]
      UNTIL NEXT.CH=' ' OR X>LL DO
        X+=1
      REPEAT
      FVAR=LINE[FRM+3,X-FRM-3]
      GOSUB CHECK.OPEN
    CASE FIRST='READ'                         ;* READ R FROM FVAR ELSE
    CASE FIRST='WRITE'                        ;* WRITE R ON FVAR ELSE
  END CASE
RETURN
*
CHECK.OPEN:
  IF S='' THEN RETURN ;* Could not figure out assignment
  FILE.NAME=S
  OPEN FILE.NAME TO DUMMY THEN CLOSE DUMMY ELSE RETURN
  LOCATE FILE.NAME IN DEP.REC<3> BY 'AL' SETTING POS THEN
    * Hmm, opened the same file twice, 2nd one is the winner
    FILE.HANDLES<1,POS>=FVAR
  END ELSE
    INS FILE.NAME BEFORE DEP.REC<3,POS>
    INS FVAR      BEFORE FILE.HANDLES<1,POS>
  END
  *
  * Also create a reverse index from filename to program
  *
  READ R FROM F.STACK.DEPS, FILE.NAME ELSE R=''
  LOCATE ID IN R<1> BY 'AL' SETTING POS ELSE
    INS ID BEFORE R<1,POS>
  END
  WRITE R ON F.STACK.DEPS, FILE.NAME
RETURN
*
GET.VAR.ASSIGNMENT:
  * Work backwards from current line looking for assighment
  VAR=''
  FOR X=LINE.CTR-1 TO 1 STEP -1
    TMP.LINE=CONVERT(' ','',TRIM(PROGRAM<X>)) ;* Get rid of all spaces, so STMT="NJS.EXIT2" and STMT  =  "NJS.EXIT2" are same
    IF FIELD(TMP.LINE,'=',1)=S THEN VAR=FIELD(TMP.LINE,'=',2) ; EXIT
  NEXT X
RETURN
*
REMOVE.QUOTES:
  S=CONVERT(\"'\,"\\",S) ;* Convert all quotes to one type
  IF S[1,1]='\' THEN
    * A quoted string, all good, remove quotes
    S=S[2,LEN(S)-2]
  END ELSE
    * Not a quoted string, search backwards for assignment
    GOSUB GET.VAR.ASSIGNMENT
    S=VAR
    S=CONVERT(\"'\,"\\",S) ;* Convert all quotes to one type
    IF S[1,1]='\' THEN
      * A quoted string, all good, remove quotes
      S=S[2,LEN(S)-2]
    END
  END
RETURN
