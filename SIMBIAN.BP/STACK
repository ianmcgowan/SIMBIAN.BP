DEPS:
  PARAM=UPCASE(FIELD(ANS,' ',2))
  IF PARAM='HELP' OR PARAM='' THEN
    PRINT 'DEPS <BP.FILE>   - Rebuild dependencies for BP.FILE'
    PRINT 'DEPS <PROGRAM>   - Show dependencies for PROGRAM'
    PRINT 'DEPS <FILE.NAME> - Show programs that use FILE.NAME'
    RETURN
  END
  * Check for BP.FILE first, so that we can build STACK.DEPS before anything that uses it
  OPEN PARAM TO F.BP THEN
    READV F1 FROM VOC, PARAM, 1 ELSE F1=''
    IF F1='DIR' THEN TYPE='BP' ELSE TYPE='FILE'
  END ELSE
    OPEN 'STACK.DEPS' TO F.STACK.DEPS ELSE PRINT 'Run DEPS <BP.FILE> first' ; RETURN
    READ R FROM F.STACK.DEPS, PARAM THEN
      TYPE='PROGRAM'
    END ELSE
      PRINT PARAM:' not a file or program, Run DEPS <BP.FILE> first'
      RETURN
    END
  END
  *
  BEGIN CASE
    CASE TYPE='BP'
      BP.FILE=PARAM
      GOSUB DEPS.BUILD
    CASE TYPE='FILE'
      OPEN 'STACK.DEPS' TO F.STACK.DEPS ELSE PRINT 'Run DEPS <BP.FILE> first' ; RETURN
      FILE.NAME=PARAM
      GOSUB FILE.DEPS
    CASE TYPE='PROGRAM'
      PROG.NAME=PARAM
      GOSUB PROG.DEPS
  END CASE
RETURN
*
FILE.DEPS:
  READ R FROM F.STACK.DEPS, FILE.NAME THEN
    FOR F=1 TO DCOUNT(R<1>,@VM)
      PRINT F'R#3':') ':R<1,F>
    NEXT F
  END
  PRINT
  PRINT 'Enter # to review, ENTER to exit:':
  INPUT O
  IF NUM(O) THEN PROG.NAME=R<1,O> ; GOSUB PROG.DEPS
RETURN
