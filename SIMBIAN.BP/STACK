  IF FILE.NAME='PARAMETER' THEN
    * Need to figure out based on record key, not just FILE.NAME
    GOSUB GET.PARAMETER.BPI
    IF BPI = '' THEN RETURN
    IF IL.MAJOR.VER=9 THEN FILE.NAME=BPI ELSE FILE.NAME=TABLE.NAME
  END
  *
  IF IL.MAJOR.VER=9 THEN
