*
ATB.FIND:
  * Search for an ATB in REV.ATB.LOG
  * HCAC>AF NUM.OF.ASSETS
  * NUM.OF.ASSETS
  *
  * IL.BPI                BILLING
  * FILE(S)               LS.MASTER,LS.BILLING  PT.PARTICIPATIONS,PT.BILLING
  * FIELD                 9
  * CHANGE LOG INDEX      02*0009
  * CHANGE LOG KEY        247
  * TYPE                  INTEGER
  * MASK                  MD0
  * S/MV                  S
  * CONTROLLING/DEPENDENT
  * SUB/MASTER FIELDS
  * CHG DESCRIPTION       Number Of Assets
  * The number of active assets associated with the contract.
  *
  IF IL.MAJOR.VER='' THEN PRINT 'Only works in IL' ; RETURN
  GOSUB ATB.OPEN
  IF NOT(ATB.OPEN.OK) THEN RETURN
  MSK="L#22"
  ATB = FIELD(ANS," ",2)
  IF ATB="" THEN RETURN
  GOSUB ATB.READ
  IF BCI.ERROR THEN
    ATBREC=""
    IF IL.MAJOR.VER=9 THEN
      EXEC.LINE=\SSELECT REV.ATB.LOG = "[\:ATB:\]"\
      PRINT EXEC.LINE
      GOSUB EXEC.SUB
    END ELSE
      SELECT.COMMAND=\SELECT ALTERNATE_ID FROM REV_ATB_LOG_NF WHERE ALTERNATE_ID LIKE '%\:ATB:\%' ORDER BY ALTERNATE_ID\
      PRINT SELECT.COMMAND
      CALL IDS.EXECUTE.ANSI.SQL.ERROR(SELECT.COMMAND, '', '', '', KEY.LIST, ERR, '', '', '', '0', '','')
      SELECT KEY.LIST
    END
    CTR=0
    LOOP
      READNEXT ID ELSE EXIT
      IF ID='' THEN CONTINUE
      CTR+=1
      PRINT CTR "L#4":ID
      ATBREC<CTR>=ID
    REPEAT
    IF CTR=0 THEN RETURN
    PRINT
    PRINT "Enter choice (1-":CTR:"): ": ; INPUT CHOICE
    IF CHOICE="" OR CHOICE="/" THEN RETURN
    ATB=ATBREC<CHOICE>
    IF ATB="" THEN RETURN
    GOSUB ATB.READ
    IF BCI.ERROR THEN
      PRINT ATB:' not found in REV.ATB.LOG' ; RETURN
    END
  END
  *
  MAXV=DCOUNT(AREC<5>,@VM)
  FNAMES=""
  FOR J=1 TO MAXV
    IF AREC<5,J>[1,2] # "BK" THEN FNAMES<-1>=(AREC<5,J>:",":AREC<6,J>)'L#35':" ":AREC<30,J>
  NEXT J
  *
  IF IL.MAJOR.VER=9 THEN
    BCI.ERROR=''
    READ HELP.TEXT FROM HELP.TEXT.USA, AREC<19> ELSE BCI.ERROR='ERROR HELP.TEXT.USA ':ATB
  END ELSE
    CALL IDS.READ(HELP.TEXT, HELP.TEXT.USA, AREC<19>, 0, 0, BCI.ERROR)
  END
  IF BCI.ERROR THEN HELP.TEXT=""
  CONVERT "~" TO "" IN HELP.TEXT
  DEP=AREC<16>
  CONVERT @VM TO "," IN DEP
  PRINT ATB
  PRINT
  PRINT "IL.BPI" MSK               :AREC<1>
  PRINT "FILE(S)" MSK              :FNAMES<1>
  IF DCOUNT(FNAMES,@AM) > 1 THEN
    FOR J=2 TO DCOUNT(FNAMES,@AM)
      PRINT " " MSK:FNAMES<J>
    NEXT J
  END
  PRINT "FIELD" MSK                :AREC<2>
  PRINT "LENGTH" MSK               :AREC<13>
  PRINT "DISP LEN" MSK             :AREC<12>:AREC<11>
  PRINT "CHANGE LOG INDEX" MSK     :AREC<24>
  PRINT "CHANGE LOG KEY" MSK       :CKEY
  PRINT "TYPE" MSK                 :AREC<3>
  PRINT "MASK" MSK                 :AREC<10>
  PRINT "S/MV" MSK                 :AREC<14>
  PRINT "CONTROLLING/DEPENDENT" MSK:AREC<15>
  PRINT "SUB/MASTER FIELDS" MSK    :DEP
  PRINT "CHG DESCRIPTION" MSK      :CHNG_REC<1>
  PRINT "COMMENTS" MSK             :AREC<32>
  PRINT
  MAXV=DCOUNT(HELP.TEXT<2>,@VM)
  FOR J=1 TO MAXV
    PRINT HELP.TEXT<2,J>
  NEXT J
  IF IL.MAJOR.VER=10 THEN
    PRINT
    SELECT.HDR=\BPI,FILE_NAME,FIELD_NAME,POS,TABLE_NAME,COLUMN_NAME,MV/S,TYPE,LEN,SCALE\
    SELECT.COMMAND = \SELECT BPI,FILE_NAME,FIELD_NAME,STRING_POS,TABLE_NAME,COLUMN_NAME,VALUE_TYPE,FIELD_TYPE,FIELD_LENGTH,SCALE\
    SELECT.COMMAND  :=\ FROM METADATA_FIELDS\
    SELECT.COMMAND  :=\ WHERE STRING_POS=\:AREC<2>:\ AND BPI='\:AREC<1>:\'\
    EMAIL=''
    GOSUB IL10.SEL
  END
RETURN
*
ATB.OPEN:
  * Open the files used by AF and BPIAF. ATB.OPEN.OK is FALSE if any file does not open
  ATB.OPEN.OK=FALSE
  CALL FILE.OPEN.OK("IL.TB.CHNG.LOG", IL.TB.CHNG.LOG, FILE.OPEN.OK)
  IF NOT(FILE.OPEN.OK) THEN PRINT 'Cannot open IL.TB.CHNG.LOG'      ; RETURN
  CALL FILE.OPEN.OK("IL.CHANGE.LOG.INDEX", IL.CHANGE.LOG.INDEX, FILE.OPEN.OK)
  IF NOT(FILE.OPEN.OK) THEN PRINT 'Cannot open IL.CHANGE.LOG.INDEX' ; RETURN
  CALL FILE.OPEN.OK("REV.ATB.LOG", REV.ATB.LOG, FILE.OPEN.OK)
  IF NOT(FILE.OPEN.OK) THEN PRINT 'Cannot open REV.ATB.LOG'         ; RETURN
  CALL FILE.OPEN.OK("HELP.TEXT.USA", HELP.TEXT.USA, FILE.OPEN.OK)
  IF NOT(FILE.OPEN.OK) THEN PRINT 'Cannot open HELP.TEXT.USA'       ; RETURN
  ATB.OPEN.OK=TRUE
RETURN
*
ATB.READ:
  * Read ATB from REV.ATB.LOG into AREC, then its change log key (CKEY) and record (CHNG_REC)
  * BCI.ERROR is set only if ATB is not in REV.ATB.LOG. A missing change log just leaves CKEY/CHNG_REC empty
  CKEY='' ; CHNG_REC=''
  IF IL.MAJOR.VER=9 THEN
    BCI.ERROR=''
    READ AREC FROM REV.ATB.LOG, ATB ELSE BCI.ERROR='CANNOT READ REV.ATB.LOG ':ATB
  END ELSE
    CALL IDS.READ(AREC, REV.ATB.LOG, ATB, 0, 0, BCI.ERROR)
  END
  IF BCI.ERROR THEN AREC='' ; RETURN
  *
  IF IL.MAJOR.VER=9 THEN
    READV CKEY FROM IL.CHANGE.LOG.INDEX, AREC<24>, 1 ELSE CKEY=''
  END ELSE
    CHG.ERROR=''
    CALL IDS.READV(CKEY, IL.CHANGE.LOG.INDEX, AREC<24>, '', 1, 0, 0, CHG.ERROR)
    IF CHG.ERROR THEN CKEY=''
  END
  IF CKEY='' THEN RETURN
  IF IL.MAJOR.VER=9 THEN
    READ CHNG_REC FROM IL.TB.CHNG.LOG, CKEY ELSE CHNG_REC=''
  END ELSE
    CHG.ERROR=''
    CALL IDS.READ(CHNG_REC, IL.TB.CHNG.LOG, CKEY, 0, 0, CHG.ERROR)
    IF CHG.ERROR THEN CHNG_REC=''
  END
RETURN
*
BPIAF:
  * Run AF for every ATB in a BPI, one line per ATB, e.g. BPIAF INVOICE.FORMAT
  * ATB names come from the EQUATEs in IL.BPI (via GET.BPI). Open positions are skipped
  IF IL.MAJOR.VER='' THEN PRINT 'Only works in IL' ; RETURN
  BPI=FIELD(ANS,' ',2)
  IF BPI='' THEN PRINT 'Usage: BPIAF <name of infolease file|name of BPI>' ; RETURN
  GOSUB GET.BPI
  IF BPI.REC='' THEN RETURN
  GOSUB ATB.OPEN
  IF NOT(ATB.OPEN.OK) THEN RETURN
  *
  * Width of the ATB column is the longest ATB name in the BPI
  ATB.WID=3
  ATB.COUNT=DCOUNT(BPI.REC,@AM)
  FOR ATB.POS=1 TO ATB.COUNT
    IF LEN(BPI.REC<ATB.POS>) > ATB.WID THEN ATB.WID=LEN(BPI.REC<ATB.POS>)
  NEXT ATB.POS
  ATB.MSK='L#':ATB.WID
  *
  * Pass 1: read every ATB into BPIAF.ROWS, so the DESCRIPTION column can be sized to the longest one
  * BPIAF.ROWS<n> = POS VM ATB VM TYPE VM MASK VM S/MV VM LEN VM C/D VM DESCRIPTION VM SUB/MASTER (or VM 'NOT.FOUND')
  BPIAF.ROWS='' ; FNAMES='' ; FOUND.CTR=0 ; NOT.FOUND.CTR=0 ; DESC.WID=11
  FOR ATB.POS=1 TO ATB.COUNT
    ATB=BPI.REC<ATB.POS>
    IF ATB='' THEN CONTINUE
    GOSUB ATB.READ
    IF BCI.ERROR THEN
      BPIAF.ROWS<-1>=ATB.POS:@VM:ATB:@VM:'NOT.FOUND'
      NOT.FOUND.CTR+=1
      CONTINUE
    END
    FOUND.CTR+=1
    IF FNAMES='' THEN
      * File names are the same for every ATB in the BPI, so take them from the first one found
      * Table names are not shown, as each MV group has its own table on IL10
      FOR J=1 TO DCOUNT(AREC<5>,@VM)
        IF AREC<5,J>[1,2] # "BK" THEN FNAMES<-1>=AREC<5,J>:",":AREC<6,J>
      NEXT J
    END
    CHG.DESC=CHNG_REC<1>
    CONVERT @VM:@SVM TO '  ' IN CHG.DESC
    IF LEN(CHG.DESC) > DESC.WID THEN DESC.WID=LEN(CHG.DESC)
    SUB.MASTER=AREC<16>
    CONVERT @VM:@SVM TO ',,' IN SUB.MASTER
    BPIAF.ROWS<-1>=ATB.POS:@VM:ATB:@VM:AREC<3>:@VM:AREC<10>:@VM:AREC<14>:@VM:AREC<13>:@VM:AREC<15>[1,1]:@VM:CHG.DESC:@VM:SUB.MASTER
  NEXT ATB.POS
  DESC.MSK='L#':DESC.WID
  *
  PRINT 'BPI      ':BPI
  FOR J=1 TO DCOUNT(FNAMES,@AM)
    IF J=1 THEN PRINT 'FILE(S)  ':FNAMES<J> ELSE PRINT '         ':FNAMES<J>
  NEXT J
  PRINT
  PRINT 'POS':' ':'ATB' ATB.MSK:' ':'TYPE' 'L#8':' ':'MASK' 'L#6':' ':'S/MV':' ':' LEN':' ':'C/D':' ':'DESCRIPTION' DESC.MSK:' ':'SUB/MASTER FIELDS'
  PRINT '---':' ':STR('-',ATB.WID):' ':STR('-',8):' ':STR('-',6):' ':STR('-',4):' ':STR('-',4):' ':'---':' ':STR('-',DESC.WID):' ':STR('-',17)
  * Pass 2: print the rows
  FOR J=1 TO DCOUNT(BPIAF.ROWS,@AM)
    ROW=BPIAF.ROWS<J>
    IF ROW<1,3>='NOT.FOUND' THEN
      PRINT ROW<1,1>'R#3':' ':ROW<1,2> ATB.MSK:' *** not found in REV.ATB.LOG'
    END ELSE
      BPIAF.LINE =ROW<1,1>'R#3':' ':ROW<1,2> ATB.MSK:' ':ROW<1,3>'L#8':' ':ROW<1,4>'L#6':' ':ROW<1,5>'L#4':' '
      BPIAF.LINE:=ROW<1,6>'R#4':' ':ROW<1,7>'L#3':' ':ROW<1,8> DESC.MSK:' ':ROW<1,9>
      PRINT BPIAF.LINE
    END
  NEXT J
  PRINT
  PRINT FOUND.CTR:' ATBs found, ':NOT.FOUND.CTR:' not found in REV.ATB.LOG'
RETURN
