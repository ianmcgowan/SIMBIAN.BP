STG = "Movies":@AM:"The Sacrifice":@VM:"Blue":@AM:"Rocky IV"
STG = REPLACE(STG,2,2,0,@NULL)
GOSUB PRINT.SETUP
PRINT "STG = ":PRT.STG
STG = REPLACE(STG,2,2,0,"Blue")
GOSUB PRINT.SETUP
PRINT "STG = ":PRT.STG
PRINT.SETUP:
PRT.STG = CHANGE(STG, @NULL, "@NULL")
PRT.STG = CHANGE(PRT.STG, @AM, "@AM")
PRT.STG = CHANGE(PRT.STG, @VM, "@VM")
RETURN
