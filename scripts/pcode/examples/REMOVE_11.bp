REC = ""
REC<1,1> = "111":@SM:"112":@SM:"113":@VM:"ABC":@SM:"DEF"
REC<2,1> = "211":@SM:"212":@VM:"QRS":@SM:"TUV":@SM:"WXY"
CRT "Remove Every Field"
DVAR = REC; * Reset Variable
@REMOVE.ATTRIBUTE = @AM
LOOP REMOVE THIS.PIECE FROM DVAR SETTING MARK
CRT THIS.PIECE:", ":
WHILE MARK DO REPEAT
CRT
CRT "Remove Every Multi-value"
DVAR = REC; * Reset Variable
@REMOVE.ATTRIBUTE = @VM
LOOP REMOVE THIS.PIECE FROM DVAR SETTING MARK
CRT THIS.PIECE:", ":
WHILE MARK DO REPEAT
CRT
CRT "Remove Every Multi-sub-value"
DVAR = REC; * Reset Variable
@REMOVE.ATTRIBUTE = @SM
LOOP REMOVE THIS.PIECE FROM DVAR SETTING MARK
CRT THIS.PIECE:", ":
WHILE MARK DO REPEAT
CRT
